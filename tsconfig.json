{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "lib":["ES2021", "DOM"],
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": ".",
    "moduleResolution": "node"
  },
  "include": [
    "app.ts",
    "bot/**/*",
    "jobs/**/*",
    "ln/**/*",
    "lnurl/**/*",
    "models/**/*",
    "util/**/*",
    "locales/**/*",
    "src/**/*",
    "src/@types/**/*",
    "node_modules/lightning/lnd_methods/offchain/pay_via_payment_request.d.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "locales"]
}
